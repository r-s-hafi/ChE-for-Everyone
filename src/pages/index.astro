---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../site.config';

// Placeholder index. The real landing page is step 6 of the build order.
const equipment = await getCollection('equipment');
const concepts = await getCollection('concepts');
const topics = [...equipment, ...concepts].sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<BaseLayout title={SITE.name} path="/">
  <h1>{SITE.name}</h1>
  <ul class="topic-list">
    {
      topics.map((topic) => (
        <li>
          <a href={`/${topic.data.category}/${topic.data.slug}`}>{topic.data.title}</a>
          <span class="topic-list-summary">{topic.data.summary}</span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
