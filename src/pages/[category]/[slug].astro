---
import { getCollection, render } from 'astro:content';
import TopicLayout from '../../layouts/TopicLayout.astro';

export async function getStaticPaths() {
  const [equipment, concepts] = await Promise.all([
    getCollection('equipment'),
    getCollection('concepts'),
  ]);

  return [...equipment, ...concepts].map((entry) => ({
    params: { category: entry.data.category, slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<TopicLayout entry={entry.data}>
  <Content />
</TopicLayout>
