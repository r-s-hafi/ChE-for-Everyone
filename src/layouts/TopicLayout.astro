---
import BaseLayout from './BaseLayout.astro';
import type { TopicFrontmatter } from '../content.config';

interface Props {
  entry: TopicFrontmatter;
}

const { entry } = Astro.props;
const path = `/${entry.category}/${entry.slug}`;
const updated = entry.updated.toISOString().slice(0, 10);
---

<BaseLayout title={entry.title} description={entry.summary} path={path}>
  <article class="topic" data-status={entry.status}>
    <header class="topic-header">
      <h1>{entry.title}</h1>
      <p class="topic-meta">
        Last updated <time datetime={updated}>{updated}</time>
      </p>
    </header>

    {/* Sections come from the markdown itself, wrapped by the rehype plugin. */}
    <slot />
  </article>
</BaseLayout>

<script>
  // The cram sheet is the shareable unit, so it gets a one-tap copy.
  document.querySelectorAll<HTMLButtonElement>('[data-copy-section]').forEach((button) => {
    button.addEventListener('click', async () => {
      const section = button.closest('section');
      const status = section?.querySelector('.copy-status');
      if (!section) return;

      // Copy the words, not the furniture.
      const clone = section.cloneNode(true) as HTMLElement;
      clone.querySelectorAll('.section-actions, .heading-anchor').forEach((el) => el.remove());
      const value = (clone.innerText ?? clone.textContent ?? '').trim();

      try {
        await navigator.clipboard.writeText(value);
        if (status) status.textContent = 'Copied.';
      } catch {
        if (status) status.textContent = "Couldn't copy, select it by hand.";
      }
      window.setTimeout(() => {
        if (status) status.textContent = '';
      }, 3000);
    });
  });
</script>
